#include <iostream>
#include <string>
using namespace std;

class Question
{
private:
    string question;
    string option1, option2, option3, option4;
    int correctAnswer;

public:

    void setQuestion(string q, string a, string b,
                     string c, string d, int answer)
    {
        question = q;
        option1 = a;
        option2 = b;
        option3 = c;
        option4 = d;
        correctAnswer = answer;
    }

    void showQuestion(int number)
    {
        cout << "\n----------------------------------\n";
        cout << "Q" << number << ". " << question << endl;
        cout << "1. " << option1 << endl;
        cout << "2. " << option2 << endl;
        cout << "3. " << option3 << endl;
        cout << "4. " << option4 << endl;
        cout << "----------------------------------\n";
    }

    bool checkAnswer(int answer)
    {
        return answer == correctAnswer;
    }

    void showCorrectAnswer()
    {
        cout << "Correct answer: ";

        if(correctAnswer == 1)
            cout << "1. " << option1 << endl;
        else if(correctAnswer == 2)
            cout << "2. " << option2 << endl;
        else if(correctAnswer == 3)
            cout << "3. " << option3 << endl;
        else
            cout << "4. " << option4 << endl;
    }
};


class QuizGame
{
private:
    Question questions[10];

public:

    QuizGame()
    {
        questions[0].setQuestion(
            "What is the capital of India?",
            "Mumbai", "Delhi", "Chennai", "Kolkata", 2);

        questions[1].setQuestion(
            "Which language is used for OOP?",
            "C++", "HTML", "CSS", "SQL", 1);

        questions[2].setQuestion(
            "Which one is a database?",
            "Oracle", "Python", "C++", "HTML", 1);

        questions[3].setQuestion(
            "Which symbol is used for comments in C++?",
            "//", "##", "**", "@@", 1);

        questions[4].setQuestion(
            "Which is a programming language?",
            "Python", "Chrome", "Windows", "Google", 1);

        questions[5].setQuestion(
            "Which data type stores an integer?",
            "float", "char", "int", "double", 3);

        questions[6].setQuestion(
            "Which keyword creates a class in C++?",
            "class", "object", "create", "newclass", 1);

        questions[7].setQuestion(
            "Which function is the starting point of C++?",
            "start()", "main()", "begin()", "run()", 2);

        questions[8].setQuestion(
            "Which header is used for cout?",
            "iostream", "string", "vector", "stdio", 1);

        questions[9].setQuestion(
            "Which operator is used for addition?",
            "-", "*", "+", "/", 3);
    }

    void startQuiz()
    {
        int answer;
        int score = 0;
        int i;

        cout << "\n==============================";
        cout << "\n        QUIZ START";
        cout << "\n==============================\n";

        for(i = 0; i < 10; i++)
        {
            // Show one question
            questions[i].showQuestion(i + 1);

            // Get answer
            do
            {
                cout << "Enter your answer (1-4): ";
                cin >> answer;

                if(answer < 1 || answer > 4)
                {
                    cout << "Please enter only 1, 2, 3 or 4.\n";
                }

            } while(answer < 1 || answer > 4);

            // Check answer
            if(questions[i].checkAnswer(answer))
            {
                cout << "\nCorrect Answer!\n";
                score++;
            }
            else
            {
                cout << "\nWrong Answer!\n";
                questions[i].showCorrectAnswer();
            }

            cout << "\nNext question...\n";
        }

        // Final result
        cout << "\n==============================";
        cout << "\n       QUIZ FINISHED";
        cout << "\n==============================\n";

        cout << "Your Score = "
             << score << " / 10\n";

        if(score == 10)
        {
            cout << "Excellent! All answers are correct.\n";
        }
        else if(score >= 5)
        {
            cout << "Good Job!\n";
        }
        else
        {
            cout << "Keep Practicing!\n";
        }
    }
};


int main()
{
    QuizGame quiz;
    int choice;

    do
    {
        cout << "\n\n========== QUIZ GAME ==========\n";
        cout << "1. Start Quiz\n";
        cout << "2. Exit\n";
        cout << "===============================\n";

        cout << "Enter choice: ";
        cin >> choice;

        if(choice == 1)
        {
            quiz.startQuiz();
        }
        else if(choice == 2)
        {
            cout << "\nThank you for playing!\n";
        }
        else
        {
            cout << "\nInvalid choice!\n";
        }

    } while(choice != 2);

    return 0;
}
